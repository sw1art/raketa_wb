# PostgreSQL
POSTGRES_DB=checkstock
POSTGRES_USER=checkstock
POSTGRES_PASSWORD=checkstock
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://checkstock:checkstock@postgres:5432/checkstock
RABBITMQ_URL=amqp://checkstock:checkstock@rabbitmq:5672/
RABBITMQ_EXCHANGE=checkstock.events
RABBITMQ_QUEUE=checkstock.events.queue
RABBITMQ_DLQ=checkstock.events.dlq
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Wildberries (опционально; без токена — демо-режим)
WB_API_TOKEN=
WB_API_BASE_URL=https://content-api.wildberries.ru
WB_MARKETPLACE_BASE_URL=https://marketplace-api.wildberries.ru
WB_STATISTICS_BASE_URL=https://statistics-api.wildberries.ru
WB_SUPPLIES_BASE_URL=https://supplies-api.wildberries.ru

# Logging
LOG_LEVEL=INFO
